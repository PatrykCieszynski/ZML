default:
    just --list

doctor:
    uv run --package zml-ocr-worker zml-ocr-worker doctor

stdio:
    uv run --package zml-ocr-worker zml-ocr-worker stdio

finder-debug *ARGS:
    uv run --package zml-ocr-worker zml-ocr-finder-debug {{ARGS}}

lint-fix:
    uv run --package zml-ocr-worker ruff check . --fix

lint:
    uv run --package zml-ocr-worker ruff check .

format:
    uv run --package zml-ocr-worker ruff format .

format-check:
    uv run --package zml-ocr-worker ruff format --check .

typecheck:
    uv run --package zml-ocr-worker pyright

test:
    uv run --package zml-ocr-worker pytest --basetemp .pytest-tmp -o cache_dir=.pytest-cache-local

verify: lint format-check typecheck test

package:
    uv run --package zml-ocr-worker pyinstaller --noconfirm --clean --onedir --name zml-ocr-worker --paths src --paths ../../packages/ocr-protocol/src --collect-submodules zml_ocr_worker --collect-submodules zml_ocr_protocol --collect-submodules tesserocr --collect-binaries tesserocr --collect-data tesserocr --hidden-import tesserocr.cysignals --add-data "resources/tessdata;tessdata" src/zml_ocr_worker/__main__.py
    powershell -NoProfile -Command "Remove-Item -Force dist/zml-ocr-worker/_internal/cv2/opencv_videoio_ffmpeg*_64.dll -ErrorAction SilentlyContinue"
