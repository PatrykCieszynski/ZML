default:
    just --list

doctor:
    uv run --package zml-ocr-agent zml-ocr-agent doctor

stdio:
    uv run --package zml-ocr-agent zml-ocr-agent stdio

finder-debug *ARGS:
    uv run --package zml-ocr-agent zml-ocr-finder-debug {{ARGS}}

lint-fix:
    uv run --package zml-ocr-agent ruff check . --fix

lint:
    uv run --package zml-ocr-agent ruff check .

format:
    uv run --package zml-ocr-agent ruff format .

format-check:
    uv run --package zml-ocr-agent ruff format --check .

typecheck:
    uv run --package zml-ocr-agent pyright

test:
    uv run --package zml-ocr-agent pytest --basetemp .pytest-tmp -o cache_dir=.pytest-cache-local

verify: lint format-check typecheck test

package:
    uv run --package zml-ocr-agent pyinstaller --noconfirm --clean --onedir --name zml-ocr-agent --paths src --paths ../../packages/ocr-protocol/src --collect-submodules zml_ocr_agent --collect-submodules zml_ocr_protocol --collect-submodules tesserocr --collect-binaries tesserocr --collect-data tesserocr --hidden-import tesserocr.cysignals --add-data "resources/tessdata;tessdata" src/zml_ocr_agent/__main__.py
    powershell -NoProfile -Command "Remove-Item -Force dist/zml-ocr-agent/_internal/cv2/opencv_videoio_ffmpeg*_64.dll -ErrorAction SilentlyContinue"
