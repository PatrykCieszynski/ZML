default:
    just --list

doctor:
    uv run zml-ocr-agent doctor

stdio:
    uv run zml-ocr-agent stdio

finder-debug *ARGS:
    uv run zml-ocr-finder-debug {{ARGS}}

lint-fix:
    uv run ruff check . --fix

lint:
    uv run ruff check .

format:
    uv run ruff format .

format-check:
    uv run ruff format --check .

typecheck:
    uv run pyright

test:
    uv run pytest --basetemp .pytest-tmp -o cache_dir=.pytest-cache-local

verify: lint format-check typecheck test

package:
    uv run pyinstaller --noconfirm --clean --onedir --name zml-ocr-agent --paths src --paths ../../packages/ocr-protocol/src --collect-submodules zml_ocr_agent --collect-submodules zml_ocr_protocol --collect-submodules tesserocr --collect-binaries tesserocr --collect-data tesserocr --hidden-import tesserocr.cysignals --add-data "resources/tessdata;tessdata" src/zml_ocr_agent/__main__.py
    powershell -NoProfile -Command "Remove-Item -Force dist/zml-ocr-agent/_internal/cv2/opencv_videoio_ffmpeg*_64.dll -ErrorAction SilentlyContinue"
